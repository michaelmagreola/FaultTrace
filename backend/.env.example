# =============================================================================
# FaultTrace API — copy to backend/.env and adjust
#   copy .env.example .env
# =============================================================================

# --- Database ----------------------------------------------------------------
# Local default (no Docker):
DATABASE_URL=sqlite:///./faulttrace.db
# Optional Postgres + pgvector:
# DATABASE_URL=postgresql+psycopg://faulttrace:faulttrace@localhost:5432/faulttrace

# --- Auth --------------------------------------------------------------------
# dev = signed local sessions after /api/auth/login. cognito = AWS (not wired yet).
AUTH_MODE=dev
# Long random string for HMAC session tokens (required in non-dev).
SESSION_SECRET=replace-with-a-long-random-secret
# Session lifetime in seconds (default 8 hours)
SESSION_TTL_SECONDS=28800
# Login brute-force protection
LOGIN_RATE_WINDOW_SECONDS=300
LOGIN_RATE_MAX_ATTEMPTS=10

# --- AI ----------------------------------------------------------------------
# local = hashing embeddings + template summary. bedrock = Amazon Bedrock (stub).
AI_MODE=local

# --- CORS (comma-separated or JSON array) ------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Retrieval tuning --------------------------------------------------------
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.12

# --- AWS (used when AUTH_MODE=cognito / AI_MODE=bedrock) ---------------------
AWS_REGION=us-east-1
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
BEDROCK_CHAT_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
